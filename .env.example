DISCORD_TOKEN=replace-me
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
CREATOR_POLL_INTERVAL_SECONDS=180
# Sprach-Transkripte für Support-Talks (lokal via whisper.cpp).
# Beide Pfade gesetzt = Feature aktiv. Aufnahme startet nur nach Zustimmung aller Teilnehmer.
WHISPER_BINARY_PATH=
WHISPER_MODEL_PATH=
# Optional: Ordner mit den .so-Bibliotheken (libwhisper.so, libggml*.so).
# Leer = Ordner der Binary. Nur nötig, wenn die Bibliotheken woanders liegen.
WHISPER_LIB_DIR=
WHISPER_THREADS=2
WHISPER_LANGUAGE=de
SERVER_STATUS_POLL_INTERVAL_SECONDS=300
SETUP_CHANNEL_NAME=bot-setup
VERIFY_DEFAULT_ROLE_NAME=Verifiziert
VERIFY_DEFAULT_CHANNEL_NAME=verify
SUPPORT_WAITING_CHANNEL_NAME=support-warteraum
SUPPORT_MANAGEMENT_CHANNEL_NAME=support-verwaltung
SUPPORT_TALK_CATEGORY_NAME=Support Talk
SUPPORT_TICKET_CATEGORY_NAME=Support Tickets
SUPPORT_TALK_CHANNEL_PREFIX=support-talk
SUPPORT_TALK_CHANNEL_COUNT=3
SUPPORT_DEFAULT_DEPARTMENT_NAME=Support
SUPPORT_DEFAULT_DEPARTMENT_ROLE_IDS=
GITHUB_TOKEN=
UPDATES_POLL_INTERVAL_MINUTES=15
AUTO_SETUP_CHANNEL_ON_GUILD_JOIN=true
LOG_LEVEL=info
# Optional: eigenes Datenverzeichnis (Standard: <projekt>/data)
# DATA_DIR=/pfad/zu/daten

